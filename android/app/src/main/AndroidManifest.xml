<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- No push until Hub Market's own Firebase project exists (no
         google-services.json yet), so the app declares no notification
         permission and nothing can put "Allow notifications?" in front of a
         user who can't receive one. This also strips the copies merged in
         from the Firebase / local-notification libraries. Delete this element
         when FCM is configured; NotificationService asks once FCM is up. -->
    <uses-permission
        android:name="android.permission.POST_NOTIFICATIONS"
        tools:node="remove"/>
    <application
        android:label="Hub Market"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- Deep links: custom scheme (hubmarket://app/...) + https app links.
                 App-links require an assetlinks.json on the domain — see
                 docs/decisions/release.md. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="hubmarket" android:host="app"/>
            </intent-filter>
            <!-- Scoped to paths the app can actually serve: both store views
                 (base_link_url = .../uae-en/, .../uae-ar/), the storefront
                 root, and root-level .html rewrites. The prefixes omit the
                 trailing slash so a shared ".../uae-en" also opens the app.
                 An unscoped host filter also claimed
                 /media, /static, /rest and /graphql, which the router
                 cannot resolve (CL042-DEV10). -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="https" android:host="hub-market.magento2.click"/>
                <data android:scheme="https" android:host="www.hub-market.magento2.click"/>
                <data android:path="/"/>
                <data android:pathPrefix="/en/"/>
                <data android:pathPrefix="/ar/"/>
                <data android:pathPattern="/.*\\.html"/>
            </intent-filter>
        </activity>

        <!-- FCM: route system-handled (background/killed) notifications to the
             app's high-importance channel, give them a valid white small icon
             (not the launcher icon → white square), and a burgundy accent. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="hubmarket_default" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_stat_notify" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@color/notification_color" />

        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- url_launcher: open web links, email and phone from the app
             (footer links, Help & FAQ contact). -->
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="https"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.SENDTO"/>
            <data android:scheme="mailto"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.DIAL"/>
            <data android:scheme="tel"/>
        </intent>
    </queries>
</manifest>
