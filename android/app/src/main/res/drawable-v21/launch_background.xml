<?xml version="1.0" encoding="utf-8"?>
<!-- Native launch screen (Figma 01a), Android 5 – 11: the logo navy with the
     app mark centred — deliberately not ?android:colorBackground, so light
     and dark mode match. Android 12+ uses values-v31/styles.xml. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/launch_background" />
    <item>
        <bitmap
            android:gravity="center"
            android:src="@drawable/launch_mark" />
    </item>
</layer-list>
