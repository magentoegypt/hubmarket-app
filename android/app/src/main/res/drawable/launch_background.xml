<?xml version="1.0" encoding="utf-8"?>
<!-- Native launch screen (Figma 01a), Android < 12: the logo navy with the app
     mark (H + cart) centred, 140 dp wide as in the frame. The same in dark
     mode. Android 12+ draws its own splash from values-v31/styles.xml. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/launch_background" />
    <item>
        <bitmap
            android:gravity="center"
            android:src="@drawable/launch_mark" />
    </item>
</layer-list>
