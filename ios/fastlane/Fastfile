default_platform(:ios)

APP_ID = "com.zoonze.shop"

# App Store Connect API key (no Apple ID / 2FA needed). Values come from the
# APP_STORE_CONNECT_* GitHub Actions secrets; the key content is base64.
def asc_api_key
  app_store_connect_api_key(
    key_id: ENV["APP_STORE_CONNECT_KEY_ID"],
    issuer_id: ENV["APP_STORE_CONNECT_ISSUER_ID"],
    key_content: ENV["APP_STORE_CONNECT_KEY_CONTENT"],
    is_key_content_base64: true,
  )
end

platform :ios do
  # Signing is done by tool/ios_appstore_build.sh (committed Apple Distribution
  # cert + App Store profile — no fastlane `match`). This lane only uploads the
  # already-signed IPA it produced in build/ios/ipa/.
  desc "Upload the pre-built prod App Store IPA to TestFlight"
  lane :beta do
    # Anchor to an absolute path: fastlane's CWD depends on where it's invoked
    # (a relative "../build/…" glob is unreliable). On CI, GITHUB_WORKSPACE is
    # the repo root where tool/ios_appstore_build.sh wrote the IPA; fall back to
    # the ios/-relative path for a local `cd ios && fastlane beta`.
    root = ENV["GITHUB_WORKSPACE"] || ".."
    ipa = Dir["#{root}/build/ios/ipa/*.ipa"].first || Dir["../build/ios/ipa/*.ipa"].first
    UI.user_error!("No IPA in build/ios/ipa — run tool/ios_appstore_build.sh first") unless ipa
    UI.message("Uploading #{ipa} to TestFlight…")
    upload_to_testflight(
      api_key: asc_api_key,
      ipa: ipa,
      skip_waiting_for_build_processing: true,
    )
  end
end
