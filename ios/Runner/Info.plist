<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<!-- Export compliance: the app uses only standard HTTPS/TLS (exempt from
	     the US encryption-export rules), so declare no non-exempt encryption.
	     This lets every TestFlight / App Store upload skip the per-build
	     encryption-compliance question. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Hub Market</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>hubmarket_app</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>UIWindowSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneClassName</key>
					<string>UIWindowScene</string>
					<key>UISceneConfigurationName</key>
					<string>flutter</string>
					<key>UISceneDelegateClassName</key>
					<string>$(PRODUCT_MODULE_NAME).SceneDelegate</string>
					<key>UISceneStoryboardFile</key>
					<string>Main</string>
				</dict>
			</array>
		</dict>
	</dict>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UIBackgroundModes</key>
	<array>
		<string>remote-notification</string>
	</array>
	<!-- App Transport Security: the storefront talks to hub-market.magento2.click over HTTPS;
	     permit it explicitly (TLS 1.2+) and allow cleartext for any http media
	     URL the catalogue returns before it's upgraded client-side. iOS blocks
	     non-conforming loads by default, so without this block any TLS edge case
	     or http image would silently fail (blank widgets / missing images). -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSExceptionDomains</key>
		<dict>
			<key>hub-market.magento2.click</key>
			<dict>
				<key>NSIncludesSubdomains</key>
				<true/>
				<key>NSExceptionAllowsInsecureHTTPLoads</key>
				<true/>
				<key>NSExceptionMinimumTLSVersion</key>
				<string>TLSv1.2</string>
			</dict>
		</dict>
	</dict>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.hubmarket.app</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>hubmarket</string>
			</array>
		</dict>
	</array>
	<!-- Routes incoming hubmarket://app/... URLs through Flutter's Router (go_router)
	     instead of just foregrounding the app. Android gets this from its
	     intent-filter; iOS needs the key, without which a password-reset link
	     opened the app on Home. No effect on https:// links — iOS universal
	     links would additionally need an Associated Domains entitlement, which
	     the app does not request. Verified by tool/ios_verify_deeplinks.sh. -->
	<key>FlutterDeepLinkingEnabled</key>
	<true/>
	<!-- url_launcher: schemes the app may open (footer links, Help contact). -->
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>https</string>
		<string>mailto</string>
		<string>tel</string>
	</array>
	<!-- image_picker: gallery access for the profile avatar. -->
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Hub Market needs access to your photos so you can set a profile picture.</string>
</dict>
</plist>
