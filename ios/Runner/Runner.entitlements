<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Push notifications (FCM/APNs). Must match the provisioning profile's
	     environment. Every CI build is DISTRIBUTION-signed — the ad-hoc
	     `hubmarket-shop-adhoc` profile (build-on-push) and the TestFlight/App Store
	     profiles all carry `aps-environment=production` (get-task-allow=false).
	     A `development` value on a distribution-signed build makes
	     `registerForRemoteNotifications` fail, so APNs hands over no device token
	     (the FCM token then stays null). Use `production`. (Only a local Xcode
	     debug run with a *development* profile would need `development`.) -->
	<!-- UNIVERSAL LINKS — intentionally NOT declared yet: an existing
	     provisioning profile never picks up a new capability, so declaring
	     this key before the portal work makes local Xcode builds fail to
	     sign, and a CI build (which re-signs from the
	     PROFILE) would ship silently WITHOUT it — universal links would just
	     keep opening Safari with no visible error.
	
	     Android declares its app-link intent filters (/en/, /ar/) too, but
	     hub-market.magento2.click does not serve /.well-known/assetlinks.json
	     yet (404 on 2026-09-29), so links open the browser there as well. It
	     needs publishing for com.hubmarket.app with the release key's SHA-256.
	     The in-app routing is already done and platform-agnostic
	     (DeepLinkResolverScreen); nothing else in Dart needs to change, and
	     FlutterDeepLinkingEnabled is already true in Info.plist.

	     To enable, IN THIS ORDER:
	       1. Publish an AASA file at BOTH
	            https://hub-market.magento2.click/.well-known/apple-app-site-association
	            https://www.hub-market.magento2.click/.well-known/apple-app-site-association
	          with Hub Market's Team ID + bundle id (the shape is in
	          docs/zoonze-reference/backend/apple-app-site-association). It must
	          be served as application/json, with NO redirect and NO file
	          extension; Apple does NOT follow redirects. Both URLs return 404
	          today (2026-09-29). Verify with tool/verify_applinks.sh.
	       2. Apple Developer portal -> Identifiers -> App ID com.hubmarket.app:
	          enable the "Associated Domains" capability.
	       3. Regenerate the app's provisioning profiles so they carry it.
	       4. Uncomment the key below.

	     Hub Market's Apple Team ID is not known yet; the AASA appIDs entry must
	     be <TeamID>.com.hubmarket.app exactly.

	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:hub-market.magento2.click</string>
		<string>applinks:www.hub-market.magento2.click</string>
	</array>
	-->

	<key>aps-environment</key>
	<string>production</string>
</dict>
</plist>
